# Dependency directories
node_modules/

# Log files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment configuration
.env
.env.local
.env.*.local

# OAuth authentication files (contain sensitive credentials)
data/auth.json
auth.json

# Sensitive data files (actual keys, token usage records, etc.)
data/key_pool.json
data/token_usage.json
data/request_stats.json

# Keep example configurations (templates may be committed)
!data/*.example.json
!data/*.template.json

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor/IDE settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.swp
*.swo
*~

# Temporary files and backups
*.tmp
*.bak
*.backup
*.old
*.orig

# Build outputs
dist/
build/
.cache/
.parcel-cache/
coverage/

# Key pool backups
key_pool.json.bak
*.json.bak

# Project-specific files
*.txt
.spec-workflow

# AI context documents (generated temporarily; excluded from version control)
.claude/
CLAUDE.md
**/CLAUDE.md
.kilocodemodes
# Documentation and test scripts (temporarily excluded)
docs/
scripts/

# Local runtime state and Python bytecode
data/banned_keys.json
data/token_usage_detail.json
__pycache__/
*.py[cod]

# Keep investigation source; exclude captured requests, images and credentials
/work/*
!/work/*.mjs
!/work/*.py
!/work/*.md

# Persistent synchronized-window attempts and cross-process ownership
data/window_sync.json
data/window_sync.lock

# Local publication exclusions
/work/
repair_codex_history_index.py
*history-index-local*.cmd
