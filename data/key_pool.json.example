{
  "keys": [],
  "stats": {
    "total": 0,
    "active": 0,
    "disabled": 0,
    "banned": 0
  },
  "poolGroups": [
    {
      "id": "default",
      "name": "Default pool",
      "priority": 100,
      "description": "Default key pool for all keys not assigned to another pool"
    }
  ],
  "config": {
    "algorithm": "round-robin",
    "retry": {
      "enabled": true,
      "maxRetries": 3,
      "retryDelay": 1000
    },
    "autoBan": {
      "enabled": true,
      "errorThreshold": 5,
      "ban402": true,
      "ban401": false
    },
    "performance": {
      "concurrentLimit": 100,
      "requestTimeout": 10000
    },
    "multiTier": {
      "enabled": true,
      "autoFallback": true
    }
  }
}
