{
  "enabled": true,
  "rules": [
    {
      "id": "rule-1",
      "name": "Blocked prompt text",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "If you are working on tasks that would benefit from a todo list please use the TodoWrite tool to create one.",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "If you working on tasks that would benefit from a todo list please use the TodoWrite tool to create one "
      },
      "description": "Affected prompt text",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-delete-sensitive-tokens",
      "name": "Remove sensitive keywords in bulk",
      "enabled": true,
      "pattern": {
        "type": "regex",
        "value": "(password|token|api_key)",
        "caseSensitive": false
      },
      "action": {
        "type": "delete_keyword",
        "mode": "targets",
        "targets": [
          "password",
          "token",
          "api_key"
        ]
      },
      "description": "When sensitive text matches, also delete the specified keywords to prevent sensitive field names from leaking",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-2",
      "name": "Blocked prompt text",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "You have not created a todo list yet. Create one with `update_todo_list`",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "You have not created a todolist yet. Create one `update_todo_list` "
      },
      "description": "Affected prompt text",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-3",
      "name": "System prompt - Kiro",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "You are Kilo Code",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "AI assistant"
      },
      "description": "Kiro keywords",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-4",
      "name": "System prompt - Claude Code",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "You are an interactive CLI tool that helps users with software engineering tasks",
        "caseSensitive": false
      },
      "action": {
        "type": "delete_keyword",
        "mode": "inline"
      },
      "description": "Claude Code keywords",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-5",
      "name": "System prompt - Claude Code",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "You are Claude Code",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "AI assistant"
      },
      "description": "Claude Code keywords",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-6",
      "name": "System prompt - Claude Code",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "As you answer the user's questions",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "user requirements"
      },
      "description": "Claude Code keywords",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-system-software-engineering",
      "name": "System prompt - software engineering",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "software engineering",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "software development"
      },
      "description": "Replace 'software engineering' with 'software development' in the system field",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-replace-sensitive",
      "name": "Replace sensitive information",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "password",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "***"
      },
      "description": "Replace 'password' with *** (example described as disabled)",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-remove-instruction",
      "name": "Remove specific instructions",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "ignore previous instructions",
        "caseSensitive": false
      },
      "action": {
        "type": "delete_keyword",
        "mode": "segment",
        "delimiter": "\n\n",
        "minLength": 50,
        "preserveKeywords": [
          "重要提示",
          "注意"
        ]
      },
      "description": "Delete the entire content block containing 'ignore previous instructions' (example described as disabled)",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-regex-example",
      "name": "Regular expression example",
      "enabled": true,
      "pattern": {
        "type": "regex",
        "value": "\\d{3}-\\d{4}-\\d{4}",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "[phone number hidden]"
      },
      "description": "Match and replace phone numbers using a regular expression (example described as disabled)",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-system-remove-droid",
      "name": "System prompt - remove Droid identity",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "Droid, an AI software engineering agent built by Factory",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "an AI assistant"
      },
      "description": "Remove the specific Droid identity from the system field",
      "errors": [],
      "alerts": []
    }
  ],
  "logging": {
    "enabled": true,
    "logMatches": true,
    "logActions": true
  }
}