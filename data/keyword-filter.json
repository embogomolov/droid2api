{
  "enabled": true,
  "rules": [
    {
      "id": "rule-1",
      "name": "黑名单提示词",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "If you are working on tasks that would benefit from a todo list please use the TodoWrite tool to create one.",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "If you working on tasks that would benefit from a todo list please use the TodoWrite tool to create one "
      },
      "description": "受影响",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-delete-sensitive-tokens",
      "name": "批量移除敏感词",
      "enabled": true,
      "pattern": {
        "type": "regex",
        "value": "(password|token|api_key)",
        "caseSensitive": false
      },
      "action": {
        "type": "delete_keyword",
        "mode": "targets",
        "targets": [
          "password",
          "token",
          "api_key"
        ]
      },
      "description": "命中敏感词时额外删除指定关键词，防止敏感字段泄漏",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-2",
      "name": "黑名单提示词",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "You have not created a todo list yet. Create one with `update_todo_list`",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "You have not created a todolist yet. Create one `update_todo_list` "
      },
      "description": "受影响",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-3",
      "name": "系统提示词-Kiro",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "You are Kilo Code",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "AI助手"
      },
      "description": "Kiro 关键词",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-4",
      "name": "系统提示词-CC",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "You are an interactive CLI tool that helps users with software engineering tasks",
        "caseSensitive": false
      },
      "action": {
        "type": "delete_keyword",
        "mode": "inline"
      },
      "description": "CC 关键词",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-5",
      "name": "系统提示词-CC",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "You are Claude Code",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "AI助手"
      },
      "description": "CC 关键词",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-6",
      "name": "系统提示词-CC",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "As you answer the user's questions",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "用户需求"
      },
      "description": "CC 关键词",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-system-software-engineering",
      "name": "系统提示词-软件工程",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "software engineering",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "软件开发"
      },
      "description": "在system字段中替换'software engineering'为'软件开发'",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-replace-sensitive",
      "name": "替换敏感信息",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "password",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "***"
      },
      "description": "将'password'替换为***（示例：已禁用）",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-remove-instruction",
      "name": "移除特定指令",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "ignore previous instructions",
        "caseSensitive": false
      },
      "action": {
        "type": "delete_keyword",
        "mode": "segment",
        "delimiter": "\n\n",
        "minLength": 50,
        "preserveKeywords": [
          "重要提示",
          "注意"
        ]
      },
      "description": "删除包含'ignore previous instructions'的整个content块（示例：已禁用）",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-regex-example",
      "name": "正则表达式示例",
      "enabled": true,
      "pattern": {
        "type": "regex",
        "value": "\\d{3}-\\d{4}-\\d{4}",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "[电话号码已隐藏]"
      },
      "description": "使用正则表达式匹配电话号码格式并替换（示例：已禁用）",
      "errors": [],
      "alerts": []
    },
    {
      "id": "rule-system-remove-droid",
      "name": "系统提示词-移除Droid标识",
      "enabled": true,
      "pattern": {
        "type": "contains",
        "value": "Droid, an AI software engineering agent built by Factory",
        "caseSensitive": false
      },
      "action": {
        "type": "replace",
        "replacement": "一个AI助手"
      },
      "description": "在system字段中移除Droid的具体标识信息",
      "errors": [],
      "alerts": []
    }
  ],
  "logging": {
    "enabled": true,
    "logMatches": true,
    "logActions": true
  }
}