# ===== 🚀 Droid2API five-level authentication =====
#
# Authentication priority (highest to lowest):
# 1️⃣ FACTORY_API_KEY environment variable (single-user mode, highest priority)
# 2️⃣ Key pool (multi-user mode; add keys through the admin API; supports key selection algorithms)
# 3️⃣ DROID_REFRESH_KEY environment variable (automatic OAuth refresh; compatible with the original droid2api)
# 4️⃣ data/auth.json / ~/.factory/auth.json (file-based authentication; backward-compatible)
# 5️⃣ Client Authorization header (pass-through mode, handled by middleware)
#
# 📖 Choosing a method:
#   - Personal use / single key → FACTORY_API_KEY (simplest)
#   - Multiple keys / load balancing → key pool (most features)
#   - Automatic refresh → DROID_REFRESH_KEY (most flexible)
#

# ===== Basic settings =====

# Proxy access key (clients must include this key to access the API)
# Request header: Authorization: Bearer your-secure-access-key
API_ACCESS_KEY=123

# Admin access key (required when accessing the admin API)
# Request header: x-admin-key: your-admin-key-here
ADMIN_ACCESS_KEY=123

# Server port
PORT=3000

# Development mode (true: detailed logging; false: production mode)
NODE_ENV=true

# ===== 1️⃣ Single-key mode (highest priority; commented out by default) =====
#
# Use cases: personal use / single key / Docker deployments
# Advantages: simple environment-variable configuration, convenient for Docker
# Limitations: no key rotation, load balancing, or fallback when the quota runs out
#
# 📌 Setting FACTORY_API_KEY bypasses all other authentication methods, including the key pool and OAuth!
#
# FACTORY_API_KEY=fk-your-factory-api-key

# ===== 3️⃣ Automatic OAuth refresh (third priority; commented out by default) =====
#
# Use cases: automatic token refresh / compatibility with the original droid2api
# Advantages: refreshes every 6 hours; falls back to the old token if refresh fails
# Limitations: depends on the WorkOS API and requires a valid refresh_token
#
# 📌 Three configuration sources, in priority order:
#   1. Environment variable: DROID_REFRESH_KEY=rt-your-refresh-token
#   2. Project-level file: data/auth.json (convenient for Docker; recommended⭐)
#   3. User-level file: ~/.factory/auth.json (shared across projects; fallback)
#
# DROID_REFRESH_KEY=your_refresh_token_here
#
# Alternatively, create data/auth.json (recommended):
# {
#   "refresh_token": "rt-your-refresh-token",
#   "api_key": "fk-cached-access-token",
#   "expires_at": 1234567890000,
#   "last_refresh": 1234567890000
# }
#
# 🔧 Skip user-level authentication configuration (set true to prevent reading the user-level file)
# Use case: avoid loading OAuth credentials from ~/.factory/auth.json
# When set, skips ~/.factory/auth.json and uses only environment variables or project-level configuration
SKIP_FACTORY_AUTH=true

# ===== System settings (applied on first startup; edit config.json afterward) =====

# 📌 Important:
# These values are read from .env only on first startup, when config.json does not exist, to generate config.json
# For subsequent changes:
#   1. Use the admin interface's "System Configuration" page (recommended)
#   2. Or edit data/config.json directly
# Runtime environment variables such as PORT and NODE_ENV always take precedence over config.json

# User-Agent string (default: factory-cli/0.19.3)
USER_AGENT=factory-cli/0.19.3

# Global system prompt
SYSTEM_PROMPT=You are Droid, an AI software engineering agent built by Factory.

# ===== Application limits =====

# Maximum incoming JSON/form body in MiB, including image attachments (restart required)
REQUEST_BODY_LIMIT_MB=256

# Maximum key notes length in characters (default: 1000)
NOTES_MAX_LENGTH=1000

# Maximum JSON log size in bytes (default: 5000)
MAX_JSON_LOG_SIZE=5000

# ===== Key pool settings =====

# Key selection algorithm (default: round-robin)
# Traditional algorithms:
#   - round-robin: assign requests to keys in sequence
#   - random: select a key at random
#   - least-used: select the key with the fewest uses
#   - weighted-score: weighted score based on success rate and usage
# 🆕 Token-usage-based algorithms:
#   - least-token-used: select the key with the lowest token usage (balances usage; recommended⭐)
#   - max-remaining: select the key with the most tokens remaining (helps avoid exhaustion; recommended⭐)
KEY_POOL_ALGORITHM=round-robin

# 🆕 Multi-tier key pools (enabled by default)
KEY_POOL_MULTI_TIER_ENABLED=true
KEY_POOL_MULTI_TIER_AUTO_FALLBACK=true

# ===== 🆕 Multi-tier key pool settings (optional, v1.4.0+) =====
# Use case: separate free and paid keys, using the free pool first
# Advantages: automatic fallback, key selection, separate pools, unified management
# Configuration: set the poolGroups array in data/key_pool.json
#
# Example configuration in data/key_pool.json:
# {
#   "poolGroups": [
#     { "id": "freebies", "name": "Free pool", "priority": 1 },
#     { "id": "main", "name": "Primary pool", "priority": 2 }
#   ],
#   "config": {
#     "multiTier": {
#       "enabled": true,
#       "autoFallback": true,
#       "strictMode": false
#     }
#   }
# }
#
# 📌 How it works:
#   1. Sort pools by priority (1 takes precedence over 2, then 3)
#   2. Select a key from the highest-priority pool
#   3. If no keys are available in that pool, fall back to the next pool
#   4. Create/delete pools and change key assignments through the admin interface
#
# 📖 Documentation: docs/MULTI_TIER_POOL.md
# 📄 Example configuration: data/key_pool.example.json

# Retry settings
KEY_POOL_RETRY_ENABLED=true
KEY_POOL_RETRY_MAX=3
KEY_POOL_RETRY_DELAY_MS=1000

# Automatic key blocking within the proxy
KEY_POOL_AUTO_BAN_ENABLED=true
KEY_POOL_ERROR_THRESHOLD=5
KEY_POOL_BAN_402=true
KEY_POOL_BAN_401=false

# Performance settings
KEY_POOL_CONCURRENT_LIMIT=100
KEY_POOL_REQUEST_TIMEOUT_MS=10000
FACTORY_API_CONCURRENCY=100    # Concurrent Factory balance queries (default: 100, matching batch operations)

# Other settings (backward-compatible)
KEY_POOL_BATCH_TEST_INTERVAL_MS=500
KEY_POOL_CACHE_TTL_MS=300000

# ===== Reasoning token budgets (optional) =====

# Low reasoning token budget (default: 4096)
REASONING_BUDGET_LOW=4096

# Medium reasoning token budget (default: 12288)
REASONING_BUDGET_MEDIUM=12288

# High reasoning token budget (default: 24576)
REASONING_BUDGET_HIGH=24576

# ===== 🆕 Automatic token usage synchronization (optional, v1.4.1+) =====

# Enable automatic token usage synchronization (default: true)
# Periodically queries the Factory API for actual token usage
# When disabled, token-usage-based selection algorithms such as least-token-used fall back to round-robin
TOKEN_SYNC_ENABLED=true

# Synchronization interval in minutes (default: 5)
# Recommended range: 1-60 minutes
# Very short intervals may trigger Factory API rate limits
TOKEN_SYNC_INTERVAL_MINUTES=5

# Synchronize immediately on startup (default: true)
# true: run one synchronization immediately when the server starts (recommended⭐)
# false: wait until the first scheduled interval
TOKEN_SYNC_ON_STARTUP=true

# Startup synchronization timeout in seconds (default: 10)
# The server waits for the initial synchronization, then continues startup if the timeout expires
# Set to 0 to start immediately without waiting (usage data may be unavailable for the first request)
TOKEN_SYNC_STARTUP_TIMEOUT_SECONDS=10

# ===== Redis caching (applied on first startup; edit config.json afterward) =====
# Redis is optional; the system runs without it
# Redis can improve performance by 30-50% for high concurrency (over 500,000 requests/day on average)

# Enable Redis (default: false)
REDIS_ENABLED=false

# Redis server address (default: 127.0.0.1)
REDIS_HOST=127.0.0.1

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis password, if configured; leave blank for no password
REDIS_PASSWORD=

# Redis database number (0-15, default: 0)
REDIS_DB=0

# Redis cache key prefix to avoid collisions (default: droid2api:)
REDIS_KEY_PREFIX=droid2api:

# ===== Cluster mode (runtime environment variables, always applied) =====
# Uses multiple CPU cores for very high concurrency (over 1,000,000 requests/day on average)
# Enable with CLUSTER_MODE=true, then run npm start

# Enable cluster mode (default: false, single process)
CLUSTER_MODE=false

# Worker count (0 = auto-detect CPU core count; default: 0)
# Recommendation: CPU core count for a single server; core count minus 1 for multi-server deployments
CLUSTER_WORKERS=0
# Optional startup/hourly inference-based key tests and legacy unban retests.
# These consume Factory quota. Disabled unless explicitly set to true.
AUTOMATIC_KEY_TESTS=false
